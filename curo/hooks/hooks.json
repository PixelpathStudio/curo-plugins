{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/curo-hook.mjs\" claude_code 2>/dev/null; exit 0",
						"async": true
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/curo-hook.mjs\" claude_code 2>/dev/null; exit 0",
						"async": true
					}
				]
			}
		]
	}
}
